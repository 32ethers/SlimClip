<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="SlimClip" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security><requestedPrivileges>
      <requestedExecutionLevel level="asInvoker" uiAccess="false" />
    </requestedPrivileges></security>
  </trustInfo>
  <!-- Keep these three fields identical to AppxManifest Identity/Applications.
       Publisher must also equal the MSIX signing certificate Subject. -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=SlimClip Development"
        packageName="SlimClip.Menu"
        applicationId="SlimClip" />
</assembly>
